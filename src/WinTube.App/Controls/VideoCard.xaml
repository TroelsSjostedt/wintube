<UserControl
    x:Class="WinTube.App.Controls.VideoCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="320">
    <Grid Background="Transparent" Tapped="OnTapped">
        <Grid.RowDefinitions>
            <RowDefinition Height="180"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem x:Name="GoToChannelItem" Text="Go to channel" Click="OnGoToChannel"/>
            </MenuFlyout>
        </Grid.ContextFlyout>

        <!-- Thumbnail with duration badge and progress line overlaid on top of it. -->
        <Grid Grid.Row="0">
            <Image x:Name="Thumbnail" Width="320" Height="180" Stretch="UniformToFill"/>
            <Border x:Name="DurationBadge" Background="#CC000000" CornerRadius="3"
                    Padding="4,1" Margin="0,0,6,6"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <TextBlock x:Name="DurationText" Foreground="White" FontSize="12"/>
            </Border>
            <Border x:Name="ProgressLine" Background="#E5342B" Height="3" Width="0"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
        </Grid>

        <TextBlock x:Name="TitleText" Grid.Row="1" Margin="0,6,0,0"
                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                   FontWeight="SemiBold"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,2,0,0" Spacing="0">
            <TextBlock x:Name="AuthorText" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       PointerEntered="OnAuthorEntered" PointerExited="OnAuthorExited"
                       Tapped="OnAuthorTapped"/>
            <TextBlock x:Name="RestText" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>
    </Grid>
</UserControl>
