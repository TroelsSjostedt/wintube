<UserControl
    x:Class="WinTube.App.Controls.ShelfScroller"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- The theme's near-transparent hover background made the chevrons vanish over the
             artwork; these keep them a solid dark pill in every state. -->
        <SolidColorBrush x:Key="ButtonBackground" Color="#B3141418"/>
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E6303038"/>
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#F0404048"/>
        <SolidColorBrush x:Key="ButtonForeground" Color="White"/>
        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/>
        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White"/>
    </UserControl.Resources>
    <Grid PointerEntered="OnPointerEntered" PointerExited="OnPointerExited"
          PointerWheelChanged="OnPointerWheelChanged">
        <ContentPresenter x:Name="Host"/>
        <!-- AllowFocusOnInteraction=False: a chevron must never take focus on click — when it
             later collapses, XAML would hand focus to the next row's ListViewItem, and the
             focus-warm preview path would start a preview nobody asked for. -->
        <Button x:Name="LeftChevron" Visibility="Collapsed" Click="OnLeftChevron"
                AllowFocusOnInteraction="False" IsTabStop="False"
                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0"
                Width="36" Height="72" Padding="0" CornerRadius="8">
            <FontIcon Glyph="&#xE76B;" FontSize="16"/>
        </Button>
        <Button x:Name="RightChevron" Visibility="Collapsed" Click="OnRightChevron"
                AllowFocusOnInteraction="False" IsTabStop="False"
                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,0"
                Width="36" Height="72" Padding="0" CornerRadius="8">
            <FontIcon Glyph="&#xE76C;" FontSize="16"/>
        </Button>
    </Grid>
</UserControl>
