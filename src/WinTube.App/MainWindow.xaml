<Window
    x:Class="WinTube.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WinTube">
    <Grid>
        <NavigationView x:Name="Nav" PaneDisplayMode="Left" IsSettingsVisible="False"
                        SelectionChanged="OnSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeItem" Content="Home" Tag="Home"/>
                <NavigationViewItem x:Name="SearchItem" Content="Search" Tag="Search"/>
                <NavigationViewItem x:Name="SubscriptionsItem" Content="Subscriptions" Tag="Subscriptions"/>
                <NavigationViewItem x:Name="HistoryItem" Content="History" Tag="History"/>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <StackPanel>
                    <Button x:Name="ProfileButton" HorizontalAlignment="Stretch" Margin="4,8,4,0"
                            HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0">
                        <TextBlock x:Name="ProfileName" TextTrimming="CharacterEllipsis"/>
                        <Button.Flyout>
                            <Flyout>
                                <Button Content="Sign out" Click="OnSignOut"/>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <TextBlock x:Name="VersionLink" Margin="16,2,4,8" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               PointerEntered="OnVersionEntered" PointerExited="OnVersionExited"
                               Tapped="OnVersionTapped"/>
                </StackPanel>
            </NavigationView.PaneFooter>
            <Frame x:Name="RootFrame"/>
        </NavigationView>
        <InfoBar x:Name="UpdateBar" IsOpen="False" Severity="Success"
                 VerticalAlignment="Top" HorizontalAlignment="Center" Margin="16">
            <InfoBar.ActionButton>
                <Button Content="Restart" Click="OnRestartForUpdate"/>
            </InfoBar.ActionButton>
        </InfoBar>
    </Grid>
</Window>
