<Window
    x:Class="WinTube.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WinTube">
    <Grid x:Name="RootGrid" KeyboardAcceleratorPlacementMode="Hidden">
        <!-- App-wide back navigation: Alt+Left mirrors the pane's own back arrow. Scoped here
             (the root, always live) rather than on a page, so it fires regardless of where
             focus sits, including inside PlayerPage. Modifiers="Menu" (Alt) never collides with
             PlayerPage's own unmodified Left accelerator (seek -10s), since accelerators match
             key+modifiers exactly. PlacementMode="Hidden" mirrors PlayerPage's own setting, so no
             "Alt+←" key-tip pops up over the page content on hover. -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="OnBackAccelerator"/>
            <!-- Ctrl+F focuses the global search bar. Same root-scoped, Hidden-placement setup
                 as Alt+Left above; on PlayerPage the bar is collapsed so the handler no-ops. -->
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFindAccelerator"/>
        </Grid.KeyboardAccelerators>
        <NavigationView x:Name="Nav" PaneDisplayMode="Left" IsSettingsVisible="False"
                        IsBackButtonVisible="Visible" IsBackEnabled="False"
                        BackRequested="OnBackRequested" ItemInvoked="OnItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeItem" Content="Home" Tag="Home"/>
                <NavigationViewItem x:Name="SearchItem" Content="Search" Tag="Search"/>
                <NavigationViewItem x:Name="SubscriptionsItem" Content="Subscriptions" Tag="Subscriptions"/>
                <NavigationViewItem x:Name="HistoryItem" Content="History" Tag="History"/>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <StackPanel>
                    <Button x:Name="ProfileButton" HorizontalAlignment="Stretch" Margin="4,8,4,0"
                            HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0">
                        <TextBlock x:Name="ProfileName" TextTrimming="CharacterEllipsis"/>
                        <Button.Flyout>
                            <Flyout>
                                <Button Content="Sign out" Click="OnSignOut"/>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <TextBlock x:Name="VersionLink" Margin="16,2,4,8" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               PointerEntered="OnVersionEntered" PointerExited="OnVersionExited"
                               Tapped="OnVersionTapped"/>
                    <TextBlock x:Name="UpdateStatus" Margin="16,0,4,8" FontSize="12"
                               TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </NavigationView.PaneFooter>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Global search bar. A row of its own (not an overlay) so every page shifts down
                     uniformly; collapsing it (PlayerPage, LoginPage) gives the row back. Stretch +
                     MaxWidth centres it once the window is wider than the cap. -->
                <AutoSuggestBox x:Name="SearchBox" Grid.Row="0"
                                QueryIcon="Find" PlaceholderText="Search"
                                MaxWidth="640" Margin="24,12,24,12"
                                HorizontalAlignment="Stretch"
                                QuerySubmitted="OnSearchSubmitted"/>
                <Frame x:Name="RootFrame" Grid.Row="1"/>
            </Grid>
        </NavigationView>
        <InfoBar x:Name="UpdateBar" IsOpen="False" Severity="Success"
                 VerticalAlignment="Top" HorizontalAlignment="Center" Margin="16">
            <InfoBar.ActionButton>
                <Button Content="Restart" Click="OnRestartForUpdate"/>
            </InfoBar.ActionButton>
        </InfoBar>
    </Grid>
</Window>
