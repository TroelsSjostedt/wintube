<Page
    x:Class="WinTube.App.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowDefinitions="Auto,*" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid Grid.Row="0" Padding="12,8" ColumnDefinitions="Auto,*">
            <Button x:Name="BackButton" Grid.Column="0" Content="Back" Click="OnBack"/>
            <TextBlock x:Name="TitleText" Grid.Column="1" Margin="12,0,0,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Style="{StaticResource SubtitleTextBlockStyle}"/>
        </Grid>

        <Grid Grid.Row="1">
            <MediaPlayerElement x:Name="Player" AreTransportControlsEnabled="True"/>

            <Border x:Name="SkipToast" Visibility="Collapsed"
                    VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,96"
                    Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                    CornerRadius="6" Padding="16,8" IsHitTestVisible="False">
                <TextBlock x:Name="SkipToastText" Style="{ThemeResource BodyTextBlockStyle}"/>
            </Border>

            <ProgressRing x:Name="LoadingRing" IsActive="True" Width="64" Height="64"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" Spacing="12"
                        HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap"
                           Style="{StaticResource BodyTextBlockStyle}"
                           HorizontalAlignment="Center"/>
                <Button Content="Back" Click="OnBack" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
