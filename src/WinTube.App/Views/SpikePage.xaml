<Page
    x:Class="WinTube.App.Views.SpikePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- TEMPORARY (libmpv stage, Task 3): MpvPlayerHost smoke test. Removed in Task 10. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="12">
            <Button x:Name="PlayButton" Content="Play (MpvPlayerHost)" Click="OnPlay"/>
            <Button x:Name="StopButton" Content="Stop" Click="OnStop"/>
            <Button Content="Pause/Play" Click="OnTogglePause"/>
            <Button Content="Seek +10s" Click="OnSeekForward"/>
            <Button Content="Seek Near End" Click="OnSeekNearEnd"/>
            <Button Content="Vol -" Click="OnVolumeDown"/>
            <Button Content="Vol +" Click="OnVolumeUp"/>
            <Button Content="Speed -" Click="OnSpeedDown"/>
            <Button Content="Speed +" Click="OnSpeedUp"/>
            <TextBlock x:Name="Status" VerticalAlignment="Center" Text="idle"/>
        </StackPanel>
        <Grid x:Name="Container" Grid.Row="1"/>
    </Grid>
</Page>
