<Page
    x:Class="WinTube.App.Views.SpikePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowDefinitions="Auto,*" Padding="12">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="VideoIdBox" Width="240" PlaceholderText="videoId (e.g. dQw4w9WgXcQ)"/>
            <Button Content="Play HLS (VISIONOS)" Click="OnPlayHls"/>
            <Button Content="Play itag 18 (ANDROID)" Click="OnPlayProgressive"/>
            <TextBlock x:Name="Status" VerticalAlignment="Center"/>
        </StackPanel>
        <MediaPlayerElement x:Name="Player" Grid.Row="1" AreTransportControlsEnabled="True"/>
    </Grid>
</Page>
