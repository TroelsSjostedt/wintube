<Page
    x:Class="WinTube.App.Views.SpikePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- TEMPORARY (libmpv stage, Task 0b): embedding-gate spike. Removed in Task 10. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="12">
            <Button x:Name="PlayButton" Content="Play (render API)" Click="OnPlay"/>
            <Button x:Name="StopButton" Content="Stop" Click="OnStop"/>
            <TextBlock x:Name="Status" VerticalAlignment="Center" Text="idle"/>
        </StackPanel>
        <SwapChainPanel x:Name="Panel" Grid.Row="1" SizeChanged="OnPanelSizeChanged"
                        CompositionScaleChanged="OnPanelScaleChanged">
            <!-- Child of the SwapChainPanel: must render ON TOP of the mpv video. -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="12"
                    Background="#A0C00000" CornerRadius="6">
                <TextBlock Text="XAML OVERLAY ABOVE VIDEO" FontSize="28" Foreground="White"/>
            </Border>
        </SwapChainPanel>
        <!-- Sibling after the panel in the same cell: also must render on top. -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="48,120,0,0"
                    Orientation="Horizontal" Spacing="12" Padding="10" Background="#A00050C0" CornerRadius="6">
            <ProgressRing IsActive="True" Width="32" Height="32" Foreground="White"/>
            <TextBlock Text="SIBLING OVERLAY" FontSize="22" Foreground="White" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Page>
