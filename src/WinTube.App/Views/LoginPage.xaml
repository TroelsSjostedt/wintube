<Page
    x:Class="WinTube.App.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16"
                MaxWidth="420">
        <TextBlock Text="Sign in to YouTube" Style="{StaticResource TitleTextBlockStyle}"/>
        <TextBlock x:Name="Instructions" TextWrapping="Wrap"
                   Text="A code is being requested…"/>
        <TextBlock x:Name="CodeText" Style="{StaticResource HeaderTextBlockStyle}"
                   IsTextSelectionEnabled="True"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="OpenBrowser" Content="Open activation page" Click="OnOpenBrowser"
                    IsEnabled="False"/>
            <Button x:Name="CopyCode" Content="Copy code" Click="OnCopyCode" IsEnabled="False"/>
        </StackPanel>
        <TextBlock x:Name="Status" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap"/>
    </StackPanel>
</Page>
